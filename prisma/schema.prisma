generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  authProvider        String               @default("password")
  email               String               @unique
  googleSubject       String?              @unique
  passwordHash        String?
  name                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  moodEntries         MoodEntry[]
  journalEntries      JournalEntry[]
  tags                Tag[]
  playlistRuns        PlaylistRun[]
  settings            UserSettings?
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  aiConsent           Boolean  @default(false)
  darkMode            Boolean  @default(false)
  privacyAcknowledged Boolean  @default(false)
  reminderEnabled     Boolean  @default(true)
  reminderTime        String   @default("20:30")
  spotifyConnected    Boolean  @default(false)
  favoriteGenres      String[] @default([])
  dislikedGenres      String[] @default([])
  preferredLanguages  String[] @default([])
  allowExplicit       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodEntry {
  id              String    @id @default(cuid())
  userId          String
  mood            Mood
  energy          Int
  stress          Int       @default(5)
  valence         Int
  note            String?
  tags            String[]
  sleepHours      Float?
  exerciseMinutes Int?
  socialLevel     Int?
  voiceNote       String?
  photoNames      String[]
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id              String           @id @default(cuid())
  userId          String
  title           String?
  content         String           @db.Text
  /// Required integer score; PostgreSQL CHECK enforces 1–10.
  moodScore       Int
  /// Optional integer scores; PostgreSQL CHECK enforces 1–10 when present.
  energyScore     Int?
  sleepHours      Float?
  exercised       Boolean?
  socialScore     Int?
  // Existing journal UI fields, preserved during the MoodEntry cutover.
  mood            Mood?
  stress          Int?
  exerciseMinutes Int?
  voiceNote       String?
  photoNames      String[]         @default([])
  archivedAt      DateTime?
  // Retained for compatibility with the original schema.
  prompt          String?
  legacyTags      String[]         @map("tags")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis        JournalAnalysis?
  tags            JournalTag[]

  @@unique([id, userId])
  @@index([userId, createdAt])
}

model Tag {
  id             String       @id @default(cuid())
  userId         String
  name           String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries JournalTag[]

  @@unique([userId, name])
  @@unique([id, userId])
}

model JournalTag {
  journalEntryId String
  tagId          String
  position       Int          @default(0)
  // Both foreign keys include userId, preventing cross-account tag links.
  userId         String
  journalEntry   JournalEntry @relation(fields: [journalEntryId, userId], references: [id, userId], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([journalEntryId, tagId])
  @@index([tagId, userId])
}

model PlaylistRun {
  id          String   @id @default(cuid())
  userId      String
  mood        Mood
  intent      Json
  provider    String
  externalUrl String?
  tracks      Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Mood {
  joyful
  calm
  anxious
  sad
  angry
  tired
  hopeful
  neutral
}

// Persistent throttling shared by all application processes; keys contain no raw email.
model AuthRateLimit {
  key      String   @id
  attempts Int
  resetAt  DateTime

  @@index([resetAt])
}

model JournalAnalysis {
  id               String       @id @default(cuid())
  journalEntryId   String       @unique
  userId           String
  sourceUpdatedAt  DateTime
  primaryEmotion   String
  emotions         String[]
  sentimentScore   Float
  themes           String[]
  estimatedEnergy  Int
  reflectionPrompt String
  confidence       Float
  createdAt        DateTime     @default(now())
  journalEntry     JournalEntry @relation(fields: [journalEntryId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([journalEntryId, userId])
  @@index([userId, createdAt])
}
