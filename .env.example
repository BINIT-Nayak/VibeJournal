# Validated at server startup; see docs/environment.md.
# No NEXT_PUBLIC_* settings are currently allowed; never expose secrets with that prefix.
# Local app + Docker infrastructure defaults; see docs/local-infrastructure.md.
# Copy to .env so both Next.js and Prisma CLI read the same values.
# For deployment, use your hosted URL (with TLS) or the container service hostname.
# URL-encode special characters in passwords: @ -> %40 and # -> %23.
DATABASE_URL=postgresql://vibejournal:vibejournal_local_only@127.0.0.1:55432/vibejournal?schema=public

# Required for Auth.js: generate with `openssl rand -base64 48`.
# Set a unique secret per environment; never commit real values.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional Google login. Register AUTH_URL + /api/auth/callback/google as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-only AI journal analysis. Leave unset to keep it disabled.
# Set AI_JOURNAL_PROVIDER=anthropic and choose a Messages-compatible model ID.
# Never use NEXT_PUBLIC_ prefixes for these values.
AI_JOURNAL_PROVIDER=
ANTHROPIC_API_KEY=
AI_JOURNAL_MODEL=
AI_JOURNAL_TIMEOUT_MS=30000

# Optional server-only Redis: analytics cache + rate-limit denial cache.
# Unset/unavailable = PostgreSQL rate limiting and uncached analytics.
# Use rediss:// with authentication for a hosted TLS-enabled Redis instance.
REDIS_URL=redis://127.0.0.1:56379

# Required server-side journal encryption. Generate the local key below before journaling.
# Production MUST use provider=aws-kms and a distinct stable environment identifier.
JOURNAL_ENCRYPTION_ENV=development
JOURNAL_KEY_PROVIDER=development
AWS_REGION=
# Symmetric encryption KMS key ARN; grant GenerateDataKey and Decrypt to the server role.
JOURNAL_KMS_KEY_ID=
# Comma-separated old key ARNs retained for decryption during rotation.
JOURNAL_KMS_PREVIOUS_KEY_IDS=
JOURNAL_DATA_KEY_VERSION=1
# Local development only: generate with `openssl rand -base64 32`.
# Keep this key stable: replacing it makes existing local journals unreadable.
# Never use this provider in production.
JOURNAL_DEVELOPMENT_WRAPPING_KEY=

# Optional privacy-limited SQL profiling (table name + duration only).
PROFILE_DATABASE=0
