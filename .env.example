# Do not include wrapping quotes in Render environment variables.
# URL-encode special characters in the password, for example @ -> %40 and # -> %23.
DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require

# Auth.js foundation: generate with `openssl rand -base64 32`.
# Set a unique secret per environment; never commit real values.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Required for Google OAuth login.
APP_URL=https://your-vibejournal-domain.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
