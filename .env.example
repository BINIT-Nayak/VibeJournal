# Do not include wrapping quotes in Render environment variables.
# URL-encode special characters in the password, for example @ -> %40 and # -> %23.
DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require

# Required for Auth.js: generate with `openssl rand -base64 48`.
# Set a unique secret per environment; never commit real values.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional Google login. Register AUTH_URL + /api/auth/callback/google as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-only AI journal analysis. Leave unset to keep it disabled.
# Set AI_JOURNAL_PROVIDER=anthropic and choose a Messages-compatible model ID.
# Never use NEXT_PUBLIC_ prefixes for these values.
AI_JOURNAL_PROVIDER=
ANTHROPIC_API_KEY=
AI_JOURNAL_MODEL=
AI_JOURNAL_TIMEOUT_MS=30000

# Optional server-only Redis: analytics cache + rate-limit denial cache.
# Unset/unavailable = PostgreSQL rate limiting and uncached analytics.
# Use rediss:// with authentication for a hosted TLS-enabled Redis instance.
REDIS_URL=

# Required server-side journal encryption. Use a stable, distinct environment identifier.
JOURNAL_ENCRYPTION_ENV=production
JOURNAL_KEY_PROVIDER=aws-kms
AWS_REGION=
# Symmetric encryption KMS key ARN; grant GenerateDataKey and Decrypt to the server role.
JOURNAL_KMS_KEY_ID=
# Comma-separated old key ARNs retained for decryption during rotation.
JOURNAL_KMS_PREVIOUS_KEY_IDS=
JOURNAL_DATA_KEY_VERSION=1
# Local development only: set provider=development and generate a random 32-byte
# base64 key in ignored .env.local. Never use this provider in production.
JOURNAL_DEVELOPMENT_WRAPPING_KEY=
