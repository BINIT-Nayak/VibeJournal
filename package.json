{
  "name": "vibejournal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss}\" --cache",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --fix --cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint:eslint && npm run lint:style && npm run format:check",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-journal-schema.mjs",
    "test:api": "node scripts/test-journal-api.mjs",
    "test:auth": "node scripts/test-auth-api.mjs",
    "test:journal": "node scripts/test-journal-rest.mjs",
    "test:dashboard": "node scripts/test-dashboard-api.mjs",
    "test:analytics": "node scripts/test-analytics-api.mjs",
    "test:mood-trend": "node scripts/test-mood-trend-api.mjs",
    "test:sleep-analysis": "node scripts/test-sleep-analysis-api.mjs",
    "test:exercise-analysis": "node scripts/test-exercise-analysis-api.mjs",
    "test:tag-analysis": "node scripts/test-tag-analysis-api.mjs",
    "test:journal-analysis": "node --conditions=react-server scripts/test-journal-analysis.mjs",
    "test:ai-provider": "node --conditions=react-server scripts/test-ai-provider.mjs",
    "test:analysis-persistence": "node --conditions=react-server scripts/test-analysis-persistence.mjs",
    "test:ai-consent": "node scripts/test-ai-consent-api.mjs",
    "test:weekly-reflection": "node --conditions=react-server scripts/test-weekly-reflection.mjs",
    "test:music": "node scripts/test-music-recommendation.mjs",
    "test:music-provider": "node --conditions=react-server scripts/test-music-provider.mjs",
    "test:music-preferences": "node scripts/test-music-preferences-api.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@prisma/client": "^6.8.2",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.17.0",
    "next": "^15.3.2",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "prettier": "^3.8.3",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3"
  }
}
